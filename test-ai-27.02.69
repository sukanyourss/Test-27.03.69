<!DOCTYPE html>

<html lang="th">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Transformer Inspection Report</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>

        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap');

        body { font-family: 'Kanit', sans-serif; background-color: #f8fafc; }

    </style>

</head>

<body class="min-h-screen flex items-center justify-center p-4">


    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden">

        <div class="bg-blue-600 p-6 text-white text-center">

            <i class="fas fa-bolt text-4xl mb-2"></i>

            <h1 class="text-2xl font-bold">รายงานผลการตรวจสอบ</h1>

            <p class="text-blue-100 opacity-90 text-sm">ระบบบันทึกข้อมูลหม้อแปลงไฟฟ้า</p>

        </div>


        <form id="inspectionForm" class="p-8 space-y-5">

            <div>

                <label class="block text-sm font-medium text-gray-700 mb-1">หมายเลขหม้อแปลง (Serial No.)</label>

                <input type="text" name="serialNo" required placeholder="เช่น TR-2024-001"

                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition">

            </div>


            <div>

                <label class="block text-sm font-medium text-gray-700 mb-1">พิกัด (Rating)</label>

                <select name="rating" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none transition">

                    <option value="">เลือกพิกัด...</option>

                    <option value="50 kVA">50 kVA</option>

                    <option value="100 kVA">100 kVA</option>

                    <option value="250 kVA">250 kVA</option>

                    <option value="500 kVA">500 kVA</option>

                </select>

            </div>


            <div>

                <label class="block text-sm font-medium text-gray-700 mb-1">ผลการตรวจสอบ</label>

                <div class="flex gap-4 mt-2">

                    <label class="flex items-center cursor-pointer">

                        <input type="radio" name="result" value="ปกติ" checked class="w-4 h-4 text-blue-600">

                        <span class="ml-2 text-gray-700">ปกติ</span>

                    </label>

                    <label class="flex items-center cursor-pointer">

                        <input type="radio" name="result" value="ชำรุด/ต้องแก้ไข" class="w-4 h-4 text-red-600">

                        <span class="ml-2 text-gray-700">ชำรุด/ต้องแก้ไข</span>

                    </label>

                </div>

            </div>


            <div>

                <label class="block text-sm font-medium text-gray-700 mb-1">รูปถ่ายหน้างาน</label>

                <div class="flex items-center justify-center w-full">

                    <label class="flex flex-col w-full h-32 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50 transition">

                        <div class="flex flex-col items-center justify-center pt-7">

                            <i class="fas fa-camera text-gray-400 text-2xl mb-2"></i>

                            <p id="fileName" class="text-xs text-gray-500">เลือกรูปภาพหรือถ่ายรูป</p>

                        </div>

                        <input type="file" id="photoInput" accept="image/*" class="hidden" required />

                    </label>

                </div>

            </div>


            <button type="submit" id="submitBtn"

                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition-all transform active:scale-95 flex justify-center items-center">

                <span>ส่งข้อมูลรายงาน</span>

            </button>

        </form>

    </div>


    <div id="loading" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">

        <div class="bg-white p-5 rounded-lg flex flex-col items-center">

            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600 mb-2"></div>

            <p>กำลังอัปโหลดข้อมูล...</p>

        </div>

    </div>


    <script>

        const scriptURL = 'https://script.google.com/macros/s/AKfycbzSkDxL-vz1dklxZ0q4cshJFV9ZTDhPaw54UIsqoJQQLJPLjDD8xJXI0KI8OKYLMYIl/exec';

        const form = document.getElementById('inspectionForm');

        const photoInput = document.getElementById('photoInput');

        const fileNameDisp = document.getElementById('fileName');

        const loading = document.getElementById('loading');


        photoInput.onchange = e => {

            if(e.target.files[0]) fileNameDisp.innerText = e.target.files[0].name;

        };


        form.addEventListener('submit', e => {

            e.preventDefault();

            loading.classList.remove('hidden');


            const reader = new FileReader();

            const file = photoInput.files[0];


            reader.onload = function() {

                const base64Data = reader.result.split(',')[1];

                const contentType = reader.result.split(',')[0];

                

                const formData = new FormData(form);

                const params = new URLSearchParams();

                

                for (const pair of formData.entries()) {

                    params.append(pair[0], pair[1]);

                }

                params.append('photo', base64Data);

                params.append('photoContent', contentType);


                fetch(scriptURL, { method: 'POST', body: params })

                    .then(response => {

                        loading.classList.add('hidden');

                        alert('บันทึกข้อมูลเรียบร้อยแล้ว!');

                        form.reset();

                        fileNameDisp.innerText = "เลือกรูปภาพหรือถ่ายรูป";

                    })

                    .catch(error => {

                        loading.classList.add('hidden');

                        alert('เกิดข้อผิดพลาด: ' + error.message);

                    });

            };

            reader.readAsDataURL(file);

        });

    </script>

</body>

</html>
